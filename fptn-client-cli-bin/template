noshlibprovides=yes
nostrip=yes
do_install() {
    cp -a "$wrksrc"/* "$DESTDIR" 2>/dev/null || true
    for dir in bin lib; do
        if [ -d "$DESTDIR/$dir" ]; then
            mkdir -p "$DESTDIR/usr"
            mv -f "$DESTDIR/$dir" "$DESTDIR/usr/"
        fi
    done
}
