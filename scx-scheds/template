# Template file for 'scx-scheds'
pkgname=scx-scheds
version=1.1.3
revision=2
build_style=cargo
make_check=no
hostmakedepends="rust clang llvm pkgconf python3 git"
makedepends="libbpf-devel libelf libseccomp-devel protobuf-devel openssl-devel zlib-devel"
depends="bash jq"
short_desc="sched_ext schedulers and tools"
maintainer="Terromur <terromuroz@proton.me>"
license="GPL-2.0-only"
homepage="https://github.com/sched-ext/scx"
changelog="https://github.com/sched-ext/scx/releases"
distfiles="https://github.com/sched-ext/scx/archive/refs/tags/v${version}.tar.gz"
checksum="4dd6dd77ce1cdb9213f14339b17b9ba284e76055f866f6aede53f2488d838979"
wrksrc="scx-${version}"
conf_files="/etc/default/scx"
do_build() {
	cargo build --release --locked \
		--workspace \
		--exclude scx_rlfifo \
		--exclude scx_mitosis \
		--exclude scx_characterize \
		--exclude xtask \
		--exclude vmlinux_docify \
		--exclude scx_arena_selftests
}
do_install() {
	for bin in target/release/*; do
		[ -f "$bin" ] || continue
		[ -x "$bin" ] || continue
		case "$bin" in
			*.so) continue ;;
		esac
		vbin "$bin"
	done
	
	vmkdir etc/default
	vinstall services/scx 644 etc/default scx
}
